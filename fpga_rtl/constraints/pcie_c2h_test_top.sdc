# Board oscillator: 25 MHz.
create_clock -name sys_clk_25m -period 40.000 [get_ports {sys_clk}]

# Let TD derive the clocks generated by the application PLL and the PCIe hard
# IP PLL.  Without this command check_timing reports the user_clk domains as
# unconstrained even though the PLL configuration is known to the device DB.
derive_clocks

# The SGDMA PLL is driven by the board oscillator, whereas the PCIe hard-IP
# user clock is recovered/generated inside the PCIe clocking block.  TD must
# not time crossings between those unrelated groups as synchronous paths.  The
# same grouping is used by the board vendor's PH1A90 Gen2 x1 reference design;
# the SGDMA/PCIe RTL contains the required synchronizers and async buffers.
set_clock_groups -asynchronous \
    -group [get_clocks {*u_sgdma_pll/pll_inst.clkc[0] *u_sgdma_pll/pll_inst.clkc[1]}] \
    -group [get_clocks {*u_al_pcie_ip_ph1_core_pll/pll_inst.clkc[0] *u_al_pcie_ip_ph1_core_pll/pll_inst.refclk *u_al_pcie_ip/core_clk}] \
    -group [get_clocks {sys_clk_25m}]

# PERST# is asynchronous to the fabric and is synchronized/released by the
# PCIe/PLL reset sequence. PCIe hard-IP timing is supplied by its own IPC SDC.
set_false_path -from [get_ports {pcie_mperst}]
