{
  "version": 1,
  "steps": [
    {
      "op": "configure",
      "configuration": {
        "schema": 2,
        "base": {
          "mode": "COLOR",
          "quality": 75,
          "flags": 0,
          "min_quality": 1,
          "frame_budget": 0,
          "restart_mcus": 0
        },
        "extension": {
          "schema": 2,
          "product_mode": 0,
          "processing_enables": 0,
          "hdr_ratio": 0,
          "hdr_black_long": 0,
          "hdr_black_short": 0,
          "hdr_motion_base": 0,
          "hdr_motion_shift": 0,
          "hdr_qualification": 0,
          "hdr_max_delta_ns": 0,
          "hdr_max_wait_ns": 0,
          "hdr_max_age_ns": 0,
          "dehaze_lut_generation": 0
        }
      }
    },
    {
      "op": "wait-product",
      "kind": "JPEG",
      "epoch": "active",
      "timeout_s": 10
    },
    {
      "op": "configure",
      "configuration": {
        "extension": {
          "processing_enables": [
            "GRAY"
          ]
        }
      }
    },
    {
      "op": "wait-product",
      "kind": "JPEG",
      "epoch": "active",
      "timeout_s": 10
    },
    {
      "op": "configure",
      "configuration": {
        "extension": {
          "processing_enables": [
            "HISTOGRAM"
          ]
        }
      }
    },
    {
      "op": "wait-product",
      "kind": "JPEG",
      "epoch": "active",
      "timeout_s": 10
    },
    {
      "op": "configure",
      "configuration": {
        "extension": {
          "processing_enables": [
            "GAUSSIAN_IMAGE"
          ]
        }
      }
    },
    {
      "op": "wait-product",
      "kind": "JPEG",
      "epoch": "active",
      "timeout_s": 10
    },
    {
      "op": "configure",
      "configuration": {
        "extension": {
          "processing_enables": [
            "MULTISCALE"
          ]
        }
      }
    },
    {
      "op": "wait-product",
      "kind": "JPEG",
      "epoch": "active",
      "timeout_s": 10
    },
    {
      "op": "configure",
      "configuration": {
        "extension": {
          "processing_enables": [
            "MULTISCALE",
            "LANE"
          ]
        }
      }
    },
    {
      "op": "wait-product",
      "kind": "JPEG",
      "epoch": "active",
      "timeout_s": 10
    },
    {
      "op": "expect",
      "path": "products.counters.rejected",
      "equals": 0
    },
    {
      "op": "expect",
      "path": "products.counters.analysis_negative_terminals",
      "equals": 0
    },
    {
      "op": "expect",
      "path": "products.counters.analysis_frame_errors",
      "equals": 0
    }
  ]
}
